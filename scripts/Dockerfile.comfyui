# ComfyUI — headless render sidecar for the `comfyui` video provider
# (services/video_providers/comfyui.py). Wan 2.2 14B i2v hero clips.
#
# GPL-3 BOUNDARY: ComfyUI is GPL-licensed and is consumed ONLY as an HTTP
# sidecar across a process boundary — never vendored, never imported. This
# Dockerfile clones a PINNED release tag at build time; nothing GPL lands in
# the repo tree. (Same conclusion the 2026-06-19 video-quality design
# recorded when it shelved ComfyUI as an optional render-layer sidecar.)
#
# Base image: PyTorch 2.8 / CUDA 12.8 — required for Blackwell (sm_120,
# RTX 5090 family), same reasoning as Dockerfile.wan. torchvision/torchaudio
# are installed from the matching cu128 wheel index BEFORE ComfyUI's
# requirements so pip cannot swap in a mismatched torch build underneath.
#
# CORE NODES ONLY, deliberately: custom nodes are ComfyUI's malware surface
# (arbitrary code fetched at runtime), and everything the provider's
# workflow needs — WanImageToVideo, the two-expert KSamplerAdvanced chain,
# LoraLoaderModelOnly, CreateVideo/SaveVideo — is in core. Do not add
# custom-node installs here without a security review.
#
# Models are NOT baked (they're ~38GB): the compose service bind-mounts
# ~/.poindexter/comfyui/models/* read-only. See
# docs/architecture/comfyui-video-provider.md for the weights layout.
FROM pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    git ffmpeg libgl1 libglib2.0-0 wget \
    && rm -rf /var/lib/apt/lists/*

# torchvision/torchaudio matched to the base image's torch 2.8.0.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu128 \
    torchvision==0.23.0 torchaudio==2.8.0

# Pinned release. Bump deliberately (it changes the render behaviour behind
# the provider) — never track master.
ARG COMFYUI_REF=v0.9.2
RUN git clone --depth 1 --branch ${COMFYUI_REF} \
    https://github.com/comfyanonymous/ComfyUI.git /comfyui
WORKDIR /comfyui
RUN pip install --no-cache-dir -r requirements.txt

# Non-root, mirroring the other GPU sidecars. ComfyUI writes to input/,
# output/, temp/ and user/ inside its own tree.
RUN addgroup --system --gid 1001 appgroup && \
    adduser --system --uid 1001 --ingroup appgroup --home /home/appuser appuser && \
    chown -R appuser:appgroup /comfyui /home/appuser
USER appuser

EXPOSE 8188

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD wget -qO /dev/null http://localhost:8188/system_stats || exit 1

CMD ["python", "main.py", "--listen", "0.0.0.0", "--port", "8188"]

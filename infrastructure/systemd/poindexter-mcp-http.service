# Poindexter MCP HTTP server (:8004) — the claude.ai-connector transport
# (mcp-server/http_server.py, OAuth-protected; probed by poindexter/brain/mcp_http_probe).
# Linux port of the Windows logon-task launcher (Pop!_OS migration audit,
# 2026-07-23). Binds 0.0.0.0 so the brain container's probe reaches it via
# host-gateway; external exposure is via Tailscale serve/funnel, not the LAN.
#
# Runs from the DEPLOY CLONE (~/.poindexter/deploy/glad-labs-stack), not a
# working checkout — deploy-checkout-sync.sh keeps the clone on origin/main
# and restarts this unit whenever a merge touches mcp-server/** (plus a
# `uv sync` when pyproject.toml/uv.lock changed), so mcp-server merges reach
# the phone surface without a manual FF + restart (the pre-2026-08-16 gap).
# The venv lives INSIDE the clone (mcp-server/.venv, gitignored — the sync's
# reset --hard + clean -fd spare it); setup-deploy-checkout.sh seeds it, and
# the sync self-heals a missing one on its next deploy pass.
#
# Operators: this file ships generic (User=poindexter, /home/poindexter paths).
# Install it once by hand: copy it to /etc/systemd/system/ (`sudo install -m
# 644`), build the venv (`uv sync --directory <clone>/mcp-server`), run
# scripts/linux/install-deploy-sync.sh to render User=, WorkingDirectory= and
# ExecStart= for your login, then `sudo systemctl enable --now` the unit. From
# then on that installer keeps it on this template (stack#4232). It refreshes a
# unit that is already installed and never installs or enables one, and it
# try-restarts the unit only when a non-comment line changed, so a comment-only
# edit here reaches the host without bouncing the connector. It replaces every
# line of the installed file except those three with this template's, so put a
# host-specific value (an API or Ollama URL that is not the default) in a
# drop-in, which it never touches: `sudo systemctl edit
# poindexter-mcp-http.service`, then
#   [Service]
#   Environment=POINDEXTER_API_URL=http://api-host:8002
# Leave POINDEXTER_MCP_HTTP_PORT alone unless you also set the brain's
# `mcp_http_probe_base_url` setting: its probe defaults to :8004.
# If the deploy-sync timer runs unprivileged, its user needs passwordless sudo
# for `systemctl restart poindexter-mcp-http.service` (same posture as
# docker-watchdog's `systemctl restart docker`). No deploy clone on this
# host? Point WorkingDirectory/ExecStart at your checkout's mcp-server/ and
# run `uv sync` there once — you're back to manual restarts on merge, and
# the installer, which needs the clone, has nothing to render from.
[Unit]
Description=Poindexter MCP HTTP server (claude.ai connector, :8004)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=poindexter
WorkingDirectory=/home/poindexter/.poindexter/deploy/glad-labs-stack/mcp-server
Environment=POINDEXTER_API_URL=http://localhost:8002
Environment=OLLAMA_URL=http://localhost:11434
Environment=POINDEXTER_MCP_HTTP_HOST=0.0.0.0
Environment=POINDEXTER_MCP_HTTP_PORT=8004
ExecStart=/home/poindexter/.poindexter/deploy/glad-labs-stack/mcp-server/.venv/bin/python http_server.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

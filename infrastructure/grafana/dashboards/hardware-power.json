    {
      "id": 56,
      "type": "timeseries",
      "title": "VRAM headroom (dedicated)",
      "description": "Per-GPU dedicated-VRAM headroom = (card total - 3 GB desktop reserve) - VRAM used, one series per GPU. Uses each card's real nvidia_gpu_memory_total_mib so it stays correct across a mixed-size multi-GPU rig (e.g. 32 GB 5090 + 24 GB 3090) instead of hardcoding the primary card's size. When a series trends toward the 0 line the NVIDIA driver is about to spill that card's VRAM into system RAM (the WDDM desktop freeze). The Windows shared-memory spill counter itself isn't in Prometheus yet (no host GPU-spill collector on Linux either) — a future exporter task.",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-orange",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "blue",
                "value": 4294967296
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          },
          "expr": "((nvidia_gpu_memory_total_mib - 3072) * 1048576) - (nvidia_gpu_memory_used_mib * 1048576)",
          "legendFormat": "GPU {{gpu}} headroom",
          "refId": "A"
        }
      ]
    },

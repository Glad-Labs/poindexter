FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir \
    asyncpg \
    httpx \
    pyyaml \
    structlog \
    python-json-logger \
    pydantic \
    pydantic-settings \
    python-dotenv \
    apscheduler \
    aiolimiter \
    tenacity

WORKDIR /app

# Phase B (GitHub #66): auto-embed is now a thin runner over the plugins/
# registry. We COPY:
#   - the script itself
#   - poindexter.memory (MemoryClient used to store embeddings)
#   - brain helpers (docker_utils, etc.)
#   - the plugins/ package (Protocols, registry, config, secrets)
#   - the services/taps/ package (the Tap implementations that
#     register via entry_points)
#   - modules/ + schemas/ (poindexter#849): plugins.registry.get_core_samples()
#     unconditionally imports every core-sample entry — including the 14
#     modules.content.stages.* classes and their schemas.video_shot_list
#     dependency — even for a caller that only wants get_taps(). Without
#     these two the sidecar logged a ModuleNotFoundError per stage class
#     on every hourly run.
COPY scripts/auto-embed.py /app/auto-embed.py
COPY src/cofounder_agent/poindexter /app/poindexter
COPY src/cofounder_agent/plugins /app/plugins
COPY src/cofounder_agent/services /app/services
COPY src/cofounder_agent/modules /app/modules
COPY src/cofounder_agent/schemas /app/schemas
COPY brain/ /brain/

ENV PYTHONPATH="/app:/"

# Drop privileges (Trivy DS-0002 / poindexter#488). auto-embed reads
# pg via asyncpg and writes embeddings back to pg — no filesystem
# state outside /app, so a non-root user is straightforward.
#
# The uid MUST match the owner of the host's ~/.claude/projects tree.
# Claude Code creates per-session scope dirs mode 0700, so a mismatched
# uid cannot even stat them — which is exactly what silently blinded the
# claude_code_sessions tap for 17 days after the Pop!_OS migration (the
# image baked uid 1001; the host user is uid 1000). Because the mount is
# read-only, there is no chown fix from inside — the uid has to line up.
#
# 1000 is the first-user uid on essentially every Linux desktop distro.
# Operators whose uid differs override at build time:
#   docker compose build --build-arg EMBEDDER_UID=$(id -u) \
#                        --build-arg EMBEDDER_GID=$(id -g) auto-embed
ARG EMBEDDER_UID=1000
ARG EMBEDDER_GID=1000
RUN groupadd --gid ${EMBEDDER_GID} embedder \
 && useradd  --uid ${EMBEDDER_UID} --gid embedder --create-home --home-dir /home/embedder embedder \
 && chown -R embedder:embedder /app /brain /home/embedder \
 && chmod 0755 /home/embedder
USER embedder

# Run every hour via shell loop (no cron daemon needed)
CMD ["sh", "-c", "while true; do python /app/auto-embed.py; sleep 3600; done"]

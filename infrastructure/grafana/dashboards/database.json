    {
      "id": 8,
      "title": "All tables — size, rows & dead %",
      "type": "table",
      "description": "Every user table, sorted by on-disk size (heap + indexes + TOAST). Sortable and filterable — this is the full-fidelity companion to the top-12 chart beside it. dead % is the vacuum signal to read, not the raw dead-row count: a small table at 90% dead tuples needs vacuum more than a large one at 0.3%. The footer totals the size column, which should track the Database Size stat below.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "local-brain-db"
      },
      "gridPos": {
        "h": 11,
        "w": 14,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total_size"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decbytes"
              },
              {
                "id": "custom.width",
                "value": 160
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dead_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "blue",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 10
                    },
                    {
                      "color": "orange",
                      "value": 25
                    },
                    {
                      "color": "dark-red",
                      "value": 50
                    }
                  ]
                }
              },
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "live_rows"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dead_rows"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "total_size",
            "desc": true
          }
        ],
        "footer": {
          "show": true,
          "reducer": ["sum"],
          "fields": ["total_size"],
          "countRows": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "local-brain-db"
          },
          "rawSql": "SELECT relname AS table_name, n_live_tup AS live_rows, n_dead_tup AS dead_rows, CASE WHEN (n_live_tup + n_dead_tup) > 0 THEN ROUND(n_dead_tup * 100.0 / (n_live_tup + n_dead_tup), 1) ELSE 0 END AS dead_pct, pg_total_relation_size(relid) AS total_size, GREATEST(last_vacuum, last_autovacuum) AS last_vacuum, last_analyze FROM pg_stat_user_tables ORDER BY total_size DESC",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ]
    },

# .git is intentionally NOT ignored: vercel.json's ignoreCommand runs
# `git diff HEAD^ HEAD` to skip unchanged builds and needs the .git dir
# present. Ignoring it here made every production deploy ERROR (see #2310).
.gitignore
README.md
.env.example
.env.local
.env.*.example
node_modules
.next
.swc
.pytest_cache
__tests__
jest.config.js
jest.setup.js
*.test.js
.docker*

# ==========================================================================
# Glad Labs Public Site — Environment Configuration
# ==========================================================================
# Local dev: copy to .env.local and fill in what you need (all optional
# unless the feature is enabled).
# Production: values come from Vercel project env, not this file.
# NEXT_PUBLIC_* values are inlined at build time, so changing one on Vercel
# takes effect at the next deploy.
# Every variable the site reads has an entry here, and nothing else does,
# bar the few its toolchain or host sets (NODE_ENV and the like), which
# __tests__/env-example.test.js lists. That test fails when the two drift.
# Never commit real secrets.
# ==========================================================================


# -------- Site identity --------
# Each default here and under Contact addresses is Glad Labs' own value, so
# production needs none of them; a fork sets its own.
# Canonical origin for every absolute URL the site builds: metadata and
# canonical links, the sitemap and robots.txt, the feeds, structured data, the
# /.well-known routes and the welcome email. Defaults to
# https://www.gladlabs.io.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Brand name in page titles, navigation, the footer, the feeds, structured
# data and the welcome email.
# NEXT_PUBLIC_SITE_NAME=Glad Labs
# Second half of the site-wide default <title>, "<site name> - <tagline>";
# pages that set their own title replace it. Defaults to
# "AI, Hardware & the Edges Where They Meet".
# NEXT_PUBLIC_SITE_TAGLINE=
# Legal entity named on the privacy, terms and cookie-policy pages. Defaults
# to "Glad Labs, LLC".
# NEXT_PUBLIC_COMPANY_NAME=
# Title of the podcast feed's autodiscovery link in every page's <head>. The
# feed itself, title included, is the XML the backend publishes. Defaults to
# "Glad Labs Podcast".
# NEXT_PUBLIC_PODCAST_NAME=


# -------- Contact addresses --------
# General contact: the footer, the error and 404 pages, the terms and privacy
# contact blocks, and the contactPoint in the Organization structured data.
# Defaults to hello@gladlabs.io.
# NEXT_PUBLIC_SUPPORT_EMAIL=
# Privacy contact: the privacy and cookie policies, and the data-request form,
# which submits to it as a mailto: link. Defaults to privacy@gladlabs.io.
# NEXT_PUBLIC_PRIVACY_EMAIL=
# First address in the cookie policy's contact block. Defaults to
# hello@gladlabs.io.
# NEXT_PUBLIC_OWNER_EMAIL=


# -------- Content (R2 static export) --------
# Base URL of the static export the backend writes to R2 on every publish.
# The site reads posts/index.json, posts/<slug>.json, categories.json,
# sitemap.json, authors.json and affiliate-referrals.json under it, and the
# podcast and video feeds from its origin (/podcast/feed.xml,
# /video/feed.xml). Its origin is also allowed in the CSP connect-src, and
# its host as a next/image source. Include the /static path and no trailing
# slash. Defaults to DEFAULT_STATIC_URL in lib/static-url.js, the Glad Labs
# bucket (https://pub-1432fdefa18e47ad98f213a8a2bf14d5.r2.dev/static), so
# production needs nothing here; a fork must set its own.
# NEXT_PUBLIC_STATIC_URL=https://<bucket>.r2.dev/static
# Hostname of a custom image domain that next/image may load from: the host
# part of the backend's storage_image_custom_domain setting. Unset allows
# images.gladlabs.io; setting it replaces that entry rather than adding to
# it. *.r2.dev is always allowed. Hostname only, no scheme. Production needs
# it only for a custom domain other than images.gladlabs.io.
# NEXT_PUBLIC_IMAGE_CDN_HOST=images.example.com


# -------- Page-view beacon --------
# Required in production. URL of the page-views-beacon Cloudflare Worker
# (infrastructure/cloudflare/page-views-beacon): ViewTracker POSTs each post
# view there, and the backend's sync_cloudflare_analytics job pulls the views
# into page_views. Its origin is also allowed in the CSP connect-src. Unset,
# the beacon goes to the same-origin /api/page-views, which no longer exists,
# so every view is lost without an error. A bare host gets https:// added.
# Set the backend's cloudflare_beacon_url setting to the same URL.
# NEXT_PUBLIC_BEACON_URL=https://page-views-beacon.<subdomain>.workers.dev


# -------- Newsletter signup (Resend) --------
# /api/newsletter/subscribe captures each signup as a contact in this Resend
# segment; the backend's SyncNewsletterAudienceJob pulls it into
# newsletter_subscribers. Without both, the route answers 503.
# RESEND_API_KEY needs contact write access (a send-only key cannot capture).
# RESEND_AUDIENCE_ID MUST equal the backend's resend_audience_id setting, or
# the backend never sees the signups (the daily signup canary checks this).
# See docs/architecture/newsletter-signup-capture.md.
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=
# Sender for the welcome email (defaults to the site's newsletter address).
# NEXT_PUBLIC_NEWSLETTER_EMAIL=


# -------- ISR revalidation --------
# Required in production. Generate: openssl rand -base64 32
# REVALIDATE_SECRET=


# -------- Error reporting: Sentry SDK -> sentry-relay -> GlitchTip (optional) --------
# Set BOTH or NEITHER. A production build fails on one without the other, and
# on a DSN the SDK would reject. Browser and server errors go to the
# sentry-relay Cloudflare Worker (the SDK's tunnel), which queues them for
# Poindexter's DrainSentryRelayJob to pull into a LAN-only GlitchTip. Errors
# only: no tracing, replays or sessions. Both are baked in at build time, so
# redeploy after changing them. See infrastructure/cloudflare/sentry-relay/README.md.
# DSN form: https://<GlitchTip key as DASHLESS hex>@<relay host>/<project id>.
# The JS SDK rejects the dashed UUID form GlitchTip displays.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_TUNNEL=https://<relay host>/relay


# -------- Google Analytics 4 (optional) --------
# Measurement ID. gtag.js loads only after the visitor consents to analytics
# (CookieConsentBanner). next.config.js defaults it to the Glad Labs property,
# G-NJMBCYNDWN, so production needs nothing here.
# Format: G-XXXXXXXXXX — https://analytics.google.com
# NEXT_PUBLIC_GA_ID=


# -------- Google Search Console --------
# Site-verification token, rendered as <meta name="google-site-verification">
# on every page. Defaults to Glad Labs' own token, so production needs
# nothing here; a fork sets its own (Search Console, HTML tag method).
# NEXT_PUBLIC_GOOGLE_VERIFICATION=


# -------- Google AdSense (optional) --------
# The adsbygoogle.js loader is injected consent-gated by CookieConsentBanner
# (only after the visitor opts in to advertising), NOT in the root layout.
# NEXT_PUBLIC_ADSENSE_ID — publisher ID, format: ca-pub-xxxxxxxxxxxxxxxx
#   (defaults to the Glad Labs account when unset). https://adsense.google.com
# NEXT_PUBLIC_ADSENSE_SLOT_ID — the ad-unit slot ID rendered at the bottom of
#   each post. Create an in-article unit in the AdSense dashboard once approved,
#   then set this to its slot ID. Empty = the <ins> is omitted (no slot, no ad).
# NEXT_PUBLIC_ADSENSE_ID=
# NEXT_PUBLIC_ADSENSE_SLOT_ID=


# -------- Giscus comments (optional) --------
# Get values from https://giscus.app
# NEXT_PUBLIC_GISCUS_REPO=
# NEXT_PUBLIC_GISCUS_REPO_ID=
# NEXT_PUBLIC_GISCUS_CATEGORY_ID=


# -------- Feature flags --------
# NEXT_PUBLIC_ENABLE_COMMENTS=true

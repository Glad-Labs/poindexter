# ============================================================
# Environment variables & secrets
# ============================================================
# Wildcard-ignore every .env variant, then allowlist placeholder
# files that are safe to commit. This covers .env.<anything-new>
# automatically — previous explicit list missed new variants.
.env*
!.env.example
!.env*.example
!.env.template
!.env*.template
# Belt-and-suspenders: list common real-env filenames explicitly so
# a misbehaving tool with weird ordering can't accidentally track them.
.env
.env.local
.env.*.local
# Auto-managed by scripts/start-stack.sh — holds decrypted Grafana
# webhook JWT (Glad-Labs/glad-labs-stack#231 hardening). Per-operator
# runtime secret, must never land in git.
.poindexter-*.env
.env.development
.env.test
.env.staging
.env.production
.env.old
.env.local.mstr
.env.local.backup
.env.vercel

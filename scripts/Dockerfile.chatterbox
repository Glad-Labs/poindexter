# TTS bake-off sidecar — ResembleAI Chatterbox (MIT), OpenAI-compatible shim.
# Build/verify is hardware-gated (GPU + first-run model download):
#   docker compose --profile tts-hq up -d chatterbox
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg wget && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    chatterbox-tts fastapi "uvicorn[standard]" soundfile

RUN useradd -m appuser
USER appuser
WORKDIR /app

# librosa (a chatterbox-tts dependency) JIT-compiles a numba function on first
# import. Numba's cache locator needs to write next to the source file it's
# caching — impossible under the root-owned site-packages appuser runs as,
# so it hard-fails with "cannot cache function ... no locator available"
# instead of silently skipping the cache. Redirect the cache to /tmp rather
# than under ~/.cache: the huggingface volume mount below causes Docker to
# auto-create ~/.cache itself as root (bind-mount parent dirs are created
# before the container's USER applies), so appuser can't write a sibling
# dir there either — /tmp is always world-writable regardless of mounts.
ENV NUMBA_CACHE_DIR=/tmp/numba_cache
COPY --chown=appuser tts_sidecars/text_chunking.py /app/text_chunking.py
COPY --chown=appuser tts_sidecars/chatterbox_server.py /app/server.py

EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]

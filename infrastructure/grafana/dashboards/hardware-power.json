    {
      "id": 57,
      "type": "stat",
      "title": "Detected VRAM pool",
      "description": "Total GPU VRAM across all cards (sum of nvidia_gpu_memory_total_mib). This is the number the dispatcher's gpu_vram_total_gb=\"auto\" budget guard derives.",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 7,
        "x": 10,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"

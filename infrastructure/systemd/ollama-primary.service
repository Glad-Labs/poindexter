# Operators: set User= to your login user (ships with a generic `poindexter`).
[Unit]
Description=Ollama primary (:11434, pinned to GPU 0)
After=network-online.target
Wants=network-online.target

[Service]
User=poindexter
Environment=OLLAMA_HOST=0.0.0.0:11434
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_CONTEXT_LENGTH=8192
Environment=OLLAMA_MODELS=/data/ollama/models
# Runs ollama-primary.sh so the GPU-0 pin is applied and ENFORCED
# (the script exits non-zero rather than starting unpinned). See
# the script header for why the pin is load-bearing for the GPU
# advisory lock's device scoping.
ExecStart=/home/poindexter/glad-labs-website/scripts/linux/ollama-primary.sh
Restart=on-failure

[Install]
WantedBy=multi-user.target

# ==========================================================================
# Glad Labs Public Site — Environment Configuration
# ==========================================================================
# Local dev: copy to .env.local and fill in what you need (all optional
# unless the feature is enabled).
# Production: values come from Vercel project env, not this file.
# Never commit real secrets.
# ==========================================================================


# -------- Site identity --------
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_NAME=Glad Labs


# -------- Newsletter signup (Resend) --------
# /api/newsletter/subscribe captures each signup as a contact in this Resend
# segment; the backend's SyncNewsletterAudienceJob pulls it into
# newsletter_subscribers. Without both, the route answers 503.
# RESEND_API_KEY needs contact write access (a send-only key cannot capture).
# RESEND_AUDIENCE_ID MUST equal the backend's resend_audience_id setting, or
# the backend never sees the signups (the daily signup canary checks this).
# See docs/architecture/newsletter-signup-capture.md.
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=
# Sender for the welcome email (defaults to the site's newsletter address).
# NEXT_PUBLIC_NEWSLETTER_EMAIL=


# -------- ISR revalidation --------
# Required in production. Generate: openssl rand -base64 32
# REVALIDATE_SECRET=


# -------- Sentry / GlitchTip (optional) --------
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# Relay tunnel for a self-hosted, LAN-only tracker (GlitchTip). Public browsers
# can't reach the LAN, so point the browser SDK at the sentry-relay Cloudflare
# Worker, which forwards to the tracker over a Tailscale Funnel. Leave unset for
# a hosted DSN. See infrastructure/cloudflare/sentry-relay/README.md.
# NEXT_PUBLIC_SENTRY_TUNNEL=https://sentry-relay.<your-domain>/relay


# -------- Google Analytics 4 (optional) --------
# Format: G-XXXXXXXXXX — https://analytics.google.com
# NEXT_PUBLIC_GA_ID=


# -------- Google AdSense (optional) --------
# The adsbygoogle.js loader is injected consent-gated by CookieConsentBanner
# (only after the visitor opts in to advertising), NOT in the root layout.
# NEXT_PUBLIC_ADSENSE_ID — publisher ID, format: ca-pub-xxxxxxxxxxxxxxxx
#   (defaults to the Glad Labs account when unset). https://adsense.google.com
# NEXT_PUBLIC_ADSENSE_SLOT_ID — the ad-unit slot ID rendered at the bottom of
#   each post. Create an in-article unit in the AdSense dashboard once approved,
#   then set this to its slot ID. Empty = the <ins> is omitted (no slot, no ad).
# NEXT_PUBLIC_ADSENSE_ID=
# NEXT_PUBLIC_ADSENSE_SLOT_ID=


# -------- Giscus comments (optional) --------
# Get values from https://giscus.app
# NEXT_PUBLIC_GISCUS_REPO=
# NEXT_PUBLIC_GISCUS_REPO_ID=
# NEXT_PUBLIC_GISCUS_CATEGORY_ID=


# -------- Feature flags --------
# NEXT_PUBLIC_ENABLE_COMMENTS=true

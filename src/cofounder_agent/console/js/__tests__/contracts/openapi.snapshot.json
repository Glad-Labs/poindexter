  "components": {
    "schemas": {
      "MediaApprovalItem": {
        "properties": {
          "post_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Post Id"
          },
          "medium": {
            "anyOf": [
              {

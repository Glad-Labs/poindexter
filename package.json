{
  "name": "poindexter-monorepo",
  "version": "0.122.0",
  "private": true,
  "description": "Poindexter — AI content pipeline with autonomous agents. Built by Glad Labs LLC.",
  "license": "Apache-2.0",
  "author": "Glad Labs LLC",
  "workspaces": [
    "packages/brand",
    "web/public-site",
    "web/storefront"
  ],
  "scripts": {
    "//": "=== CORE WORKFLOWS ===",
    "dev": "concurrently -n backend,frontend \"npm run dev:cofounder\" \"npm run dev:public\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\" \"!**/package-lock.json\" \"!**/node_modules/**\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\" \"!**/package-lock.json\" \"!**/node_modules/**\"",
    "ci": "npm run format:check && npm run lint && npm run test:ci",
    "// services": "=== SERVICE STARTUP (host dev; the operator stack runs these in Docker) ===",
    "dev:cofounder": "cd src/cofounder_agent && poetry run uvicorn main:app --reload --host 0.0.0.0 --port 8002 --log-level info",
    "dev:public": "npm run dev --workspace=web/public-site",
    "build:frontend": "npm run build --workspace=web/public-site --if-present",
    "// setup": "=== SETUP ===",
    "setup": "npm install && npm run setup:python",
    "setup:python": "poetry -C src/cofounder_agent install",
    "clean": "rimraf --glob node_modules package-lock.json yarn.lock **/node_modules **/dist **/.next **/build .venv __pycache__ **/__pycache__ **/*.pyc",
    "clean:install": "npm run clean && npm run setup",
    "prepare": "node -e \"process.exit(process.env.CI || process.env.VERCEL ? 0 : 1)\" || husky",
    "// python": "=== PYTHON QUALITY + TESTS (backend poetry env at src/cofounder_agent) ===",
    "format:python": "cd src/cofounder_agent && poetry run black . && poetry run isort .",
    "lint:python": "cd src/cofounder_agent && poetry run ruff check .",
    "type:check": "cd src/cofounder_agent && poetry run python -m mypy --config-file=../../pyproject.toml",
    "test:python": "cd src/cofounder_agent && poetry run pytest tests/unit/ -q",
    "test:python:integration": "cd src/cofounder_agent && poetry run pytest tests/integration/ -q",
    "benchmark": "cd src/cofounder_agent && poetry run pytest tests/benchmarks/ --benchmark-only -v --benchmark-sort=mean",
    "// web-tests": "=== FRONTEND + E2E TESTS ===",
    "test:ci": "npm run test --workspace=web/public-site --if-present -- --ci --coverage --watchAll=false --maxWorkers=2",
    "test:console": "node --test \"src/cofounder_agent/console/js/__tests__/**/*.test.js\"",
    "test:watch": "npm run test --workspaces --if-present -- --watch",
    "test:coverage": "npm run test --workspaces --if-present -- --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen http://localhost:3000",
    "test:all": "npm run test && npm run test:e2e",
    "validate:all": "npm run format:check && npm run lint && npm run type:check"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "baseline-browser-mapping": "^2.11.12",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "markdownlint-cli": "^0.49.1",
    "next": "^16.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "svgo": "^2.8.0",
    "@svgr/webpack": "^6.5.1",
    "postcss": "^8.4.47",
    "undici": "^6.21.2",
    "esbuild": ">=0.24.4",
    "nth-check": ">=2.1.1",
    "minimatch": ">=9.0.7",
    "test-exclude": "^7.0.1",
    "jsonpath": ">=1.1.2",
    "underscore": ">=1.13.7",
    "sharp": "^0.35.0"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.4",
    "@rollup/rollup-linux-x64-musl": "^4.62.4"
  }
}

  "paths": {
    "/api/metrics/costs/budget": {
      "get": {
        "tags": ["metrics"],
        "summary": "Get Budget Status",
        "description": "Get budget status and alerts for Week 2 dashboard\n\n**Parameters:**\n- monthly_budget: Monthly limit in USD. Omit to use the operator's real cap\n  from ``app_settings.monthly_spend_limit_usd`` (no hardcoded $150); supply a\n  value only to override for a what-if view.\n\n**Returns:**\n- Amount spent vs remaining\n- Percent used with color coding\n- Daily burn rate\n- Projected final month cost\n- Alerts (80%, 100% thresholds)\n\n**Example:** Shows spent $12.50, remaining $137.50, 8.33% used, status: healthy",
        "operationId": "get_budget_status_api_metrics_costs_budget_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "monthly_budget",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 10000,
                  "minimum": 10
                },
                {
                  "type": "null"
                }
              ],
              "title": "Monthly Budget"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Budget Status Api Metrics Costs Budget Get"
                }
              }
            }
          },
          "400": {
            "description": "Request validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error_code", "message", "request_id"],
                  "properties": {
                    "error_code": {
                      "type": "string",
                      "example": "VALIDATION_ERROR"
                    },
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": "Field-level validation errors (field path → message)"
                    },
                    "request_id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

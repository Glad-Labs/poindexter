{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Content Pipeline (worker)",
    "version": "0.122.0"
  },
  "paths": {
    "/api/metrics/costs/budget": {
      "get": {
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Budget Status Api Metrics Costs Budget Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "responses": {
          "200": {
            "description": "List of settings filtered by user role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "responses": {
          "201": {
            "description": "Setting created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/media-approval/pending": {
      "get": {
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaApprovalListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/scheduling": {
      "get": {
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response List Scheduled Api Scheduling Get"
                }
              }
            }
          }
        }
      },
      "delete": {
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Clear Api Scheduling Delete"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MediaApprovalItem": {
        "properties": {
          "post_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Post Id"
          },
          "medium": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Medium"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slug"
          },
          "quality_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quality Score"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          }
        },
        "type": "object",
        "title": "MediaApprovalItem",
        "description": "One row in the Gate-2 media-approval queue (#1343).\n\nThe operator-facing projection joined with the post's title/slug. The\ninternal scoring columns (``quality_signals`` / ``quality_evaluated_at``)\nare intentionally not surfaced over HTTP — the ``poindexter media pending``\nCLI reads those straight from the service, not this endpoint."
      },
      "MediaApprovalListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MediaApprovalItem"
            },
            "type": "array",
            "title": "Items",
            "description": "The page of results (never null)"
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "title": "Total",
            "description": "Total matching rows across all pages"
          },
          "limit": {
            "type": "integer",
            "minimum": 0,
            "title": "Limit",
            "description": "Page size echoed back (the LIMIT)"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "title": "Offset",
            "description": "Window start echoed back (the OFFSET)",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "total",
          "limit"
        ],
        "title": "MediaApprovalListResponse",
        "description": "Pending media queue — canonical offset envelope (poindexter#745).\n\n``{items, total, limit, offset}`` via ``ListResponse[MediaApprovalItem]``.\nReplaces the prior untyped ``dict[str, Any]`` body that used a ``media`` key.\nThe list is capped at ``limit`` with no cursor, so ``offset`` is always 0.\nOperator Gate-2 surface (OAuth-JWT); the operator console reads ``items`` in\nlockstep."
      },
      "SettingDataTypeEnum": {
        "type": "string",
        "enum": [
          "string",
          "int",
          "float",
          "bool",
          "json"
        ],
        "title": "SettingDataTypeEnum",
        "description": "Setting data type"
      },
      "SettingEnvironmentEnum": {
        "type": "string",
        "enum": [
          "all",
          "development",
          "staging",
          "production"
        ],
        "title": "SettingEnvironmentEnum",
        "description": "Environment scope"
      },
      "SettingListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SettingResponse"
            },
            "type": "array",
            "title": "Items",
            "description": "The page of results (never null)"
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "title": "Total",
            "description": "Total matching rows across all pages"
          },
          "limit": {
            "type": "integer",
            "minimum": 0,
            "title": "Limit",
            "description": "Page size echoed back (the LIMIT)"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "title": "Offset",
            "description": "Window start echoed back (the OFFSET)",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "total",
          "limit"
        ],
        "title": "SettingListResponse",
        "description": "Settings list — canonical offset envelope (poindexter#745).\n\n``{items, total, limit, offset}`` via ``ListResponse[SettingResponse]``.\nCompletes the #635 offset/limit canonicalization on the response side (the\nrequest side already accepted offset/limit); the page-based response fields\n(page/per_page/pages) were retired."
      },
      "SettingResponse": {
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Key",
            "description": "Unique setting identifier"
          },
          "value": {
            "type": "string",
            "title": "Value",
            "description": "Setting value (can be complex JSON)"
          },
          "data_type": {
            "$ref": "#/components/schemas/SettingDataTypeEnum",
            "description": "Data type of value",
            "default": "string"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category",
            "description": "Setting category for organization"
          },
          "environment": {
            "$ref": "#/components/schemas/SettingEnvironmentEnum",
            "description": "Environment applicability",
            "default": "all"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "Human-readable description"
          },
          "is_encrypted": {
            "type": "boolean",
            "title": "Is Encrypted",
            "description": "Whether value is encrypted (secrets, passwords)",
            "default": false
          },
          "is_read_only": {
            "type": "boolean",
            "title": "Is Read Only",
            "description": "Whether this setting can be modified",
            "default": false
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags",
            "description": "Tags for filtering and organization"
          },
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Setting database ID"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At",
            "description": "Creation timestamp"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At",
            "description": "Last update timestamp"
          },
          "value_preview": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value Preview",
            "description": "Preview of value (for encrypted values)"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner",
            "description": "Module/service that is the primary reader of this key"
          },
          "value_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value Type",
            "description": "Declared value type (string/boolean/integer/float/url/model/csv/json/duration)"
          },
          "deprecated": {
            "type": "boolean",
            "title": "Deprecated",
            "description": "Whether this key has been renamed or superseded",
            "default": false
          },
          "superseded_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Superseded By",
            "description": "Replacement key to migrate to, when deprecated"
          }
        },
        "type": "object",
        "required": [
          "key",
          "value",
          "id"
        ],
        "title": "SettingResponse",
        "description": "Model for returning setting data"
      }
    }
  }
}

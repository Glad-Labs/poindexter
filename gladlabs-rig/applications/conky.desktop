# Shadows /usr/share/applications/conky.desktop (same desktop-file ID, and
# XDG_DATA_HOME wins the lookup). The packaged entry runs a bare
# `conky --daemonize --pause=1`, which has no -c flag and no ~/.conkyrc, so it
# loads stock /etc/conky/conky.conf and anchors to xinerama head 0 (the primary
# Acer) instead of the 8.8" strip. This override drives the systemd user unit
# that passes sensor-strip.conf plus the per-boot -x/-y offsets.
[Desktop Entry]
Type=Application
Name=Conky Sensor Strip
Comment=Restart the 8.8" sensor strip panel (conky-strip.service)
Exec=systemctl --user restart conky-strip.service
Icon=conky-logomark-violet
Terminal=false
StartupNotify=false
Categories=System;Monitor;
Keywords=conky;strip;sensor;sensors;temps;temperature;monitor;
Actions=Stop;Logs;

[Desktop Action Stop]
Name=Stop Sensor Strip
Exec=systemctl --user stop conky-strip.service

# Terminal= is not valid inside an action group (desktop-file-validate rejects
# it), so the terminal is invoked explicitly. x-terminal-emulator is the Debian
# alternative -> cosmic-term here; its -e is undocumented but works.
[Desktop Action Logs]
Name=View Strip Logs
Exec=x-terminal-emulator -e journalctl --user -u conky-strip.service -n 200 -f

[Unit]
Description=Temperature-reactive ARGB sync (Aura/Strimer, DIMMs, GPU shrouds)
Wants=openrgb-server.service
After=openrgb-server.service

[Service]
ExecStart=/home/mattm/.local/share/openrgb-venv/bin/python /home/mattm/.config/openrgb-temp-sync/sync.py
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target

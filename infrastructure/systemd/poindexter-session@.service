# Template unit — one instance per ops session (e.g. poindexter-session@alert-triage).
# Do not hand-edit the installed copy: scripts/linux/install-session-timers.sh
# renders User= and the ExecStart path onto the host (this repo copy ships a
# generic `poindexter` / /home/poindexter placeholder) and installs it alongside
# the per-session .timer files. Re-run the installer after editing this file —
# the installed render never updates on its own.
[Unit]
Description=Poindexter ops session %i
After=network-online.target

[Service]
Type=oneshot
User=poindexter
ExecStart=/home/poindexter/glad-labs-website/scripts/linux/run-session.sh %i

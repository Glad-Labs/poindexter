# TTS bake-off sidecar — FunAudioLLM CosyVoice2-0.5B (Apache-2.0), OpenAI shim.
# Build/verify is hardware-gated. The upstream commit is pinned below; the
# reference clip at tts_sidecars/assets/stock_speaker_16k.wav is generated by
# the bake-off runbook (Kokoro-derived, swappable — see assets/README.md).
#   docker compose --profile tts-hq up -d cosyvoice2
FROM python:3.11-slim

# build-essential: pyworld (and other sdist deps) compile C/Cython at install.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg git wget build-essential && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Pinned to FunAudioLLM/CosyVoice HEAD as of 2026-07-10 (bake-off build).
RUN git clone https://github.com/FunAudioLLM/CosyVoice.git /app/CosyVoice \
    && cd /app/CosyVoice && git checkout 074ca6dc9e80a2f424f1f74b48bdd7d3fea531cc \
    && git submodule update --init --recursive

# setuptools<80 keeps `pkg_resources` (newer setuptools dropped it, which several
# CosyVoice deps' legacy setup.py builds import). PIP_CONSTRAINT applies it to
# pip's isolated build environments too, where the failure actually occurs.
RUN printf 'setuptools<80\n' > /tmp/pip-constraints.txt
ENV PIP_CONSTRAINT=/tmp/pip-constraints.txt
RUN pip install --no-cache-dir --upgrade pip "setuptools<80" wheel

# The bake-off sidecar runs CPU-only with load_trt=False, so drop the linux-only
# GPU accelerators (tensorrt-cu12*, deepspeed) and use CPU onnxruntime. torch
# stays on the cu121 wheels (runs fine on CPU); the model is 0.5B.
RUN grep -vE '^(deepspeed|tensorrt-cu12)' /app/CosyVoice/requirements.txt \
      | sed 's/^onnxruntime-gpu==1.18.0.*/onnxruntime==1.18.0/' > /tmp/reqs.txt \
    && pip install --no-cache-dir -r /tmp/reqs.txt \
    fastapi "uvicorn[standard]" soundfile
ENV PYTHONPATH=/app/CosyVoice:/app/CosyVoice/third_party/Matcha-TTS

# Model weights downloaded at build (or mount via the HF cache volume).
RUN python -c "from modelscope import snapshot_download; \
    snapshot_download('iic/CosyVoice2-0.5B', local_dir='/app/pretrained_models/CosyVoice2-0.5B')"

# Stock speaker: a short 16 kHz neutral clip (see tts_sidecars/assets/README.md).
COPY tts_sidecars/assets/stock_speaker_16k.wav /app/assets/stock_speaker_16k.wav
COPY tts_sidecars/text_chunking.py /app/text_chunking.py
COPY tts_sidecars/cosyvoice2_server.py /app/server.py

# Run as non-root (Trivy DS-0002). Done after all root-level installs + the
# model download; chown so the runtime user can read the weights and write any
# runtime caches. Mirrors Dockerfile.chatterbox's appuser drop.
RUN useradd -m appuser && chown -R appuser /app
USER appuser

EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]

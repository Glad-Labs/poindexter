# Image Generation Server — GPU-accelerated container
# Requires NVIDIA runtime (deploy.resources.reservations.devices in compose)
#
# 2026-05-08: bumped 2.5.1-cu124 → 2.9.1-cu128 to add Blackwell (sm_120)
# kernel images. The 5090 was reporting compute capability (12, 0) but
# torch 2.5.1's bundled arch list stopped at sm_90, so every GPU op
# failed with "no kernel image is available for execution on the
# device" — see Glad-Labs/poindexter#334.
# BEFORE BUMPING THIS BASE: pytorch/pytorch 2.10+ is Ubuntu-based with a
# PEP 668 externally-managed Python, so the bare `pip install` below fails with
# "error: externally-managed-environment" and every sidecar image stops
# building — the deploy then retries a doomed build every ten minutes and never
# records its marker (#3756 reverted by #3794; #3915 reverted by #3946).
# Moving up needs `pip install --break-system-packages` (torch lives in the
# same /usr/local dist-packages pip targets, so a venv would re-download it)
# AND a local `docker compose build` first: CI does not build these images.
FROM pytorch/pytorch:2.9.1-cuda12.8-cudnn9-runtime

WORKDIR /app

# System deps for Pillow / image handling
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 wget \
    && rm -rf /var/lib/apt/lists/*

# Python deps
# easyocr: powers the OCR text-leakage gate in /generate (2026-07-13) — CPU-only
# (reuses the torchvision already required above), so it doesn't compete with
# the diffusion pipeline for VRAM.
#
# PIP_BREAK_SYSTEM_PACKAGES: the pytorch base images now ship a PEP 668
# `EXTERNALLY-MANAGED` marker, so a bare `pip install` dies with
# `error: externally-managed-environment`. In a container the system
# interpreter IS the application environment — there is no distro Python to
# protect and no second consumer to break — so opting out is correct here,
# where on a host it would not be.
#
# This is why the 2026-09-15 base bump (#3756) was reverted (#3794) and why the
# identical bump re-landed on 2026-09-22 (#3915) and broke the deploy again: a
# revert does not stop dependabot re-proposing, it only delays it. Fixing the
# incompatibility lets the bump stand.
ENV PIP_BREAK_SYSTEM_PACKAGES=1
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    asyncpg \
    diffusers \
    "transformers>=4.44,<5.0" \
    torchvision \
    accelerate \
    safetensors \
    pydantic \
    httpx \
    xformers \
    invisible-watermark \
    peft \
    easyocr

COPY image-gen-server.py /app/server.py

# Non-root user (GPU access via group, not root)
# groupadd/useradd (shadow), not addgroup/adduser (Debian `adduser` package).
# The same base bump that added the PEP 668 marker also dropped the adduser
# wrappers, so the previous form died with exit 127 "command not found" — after
# the pip layer, which is why fixing only the pip error was not enough. shadow's
# tools are present in the base and are the portable choice.
RUN groupadd --system --gid 1001 appgroup && \
    useradd --system --uid 1001 --gid appgroup --create-home --home-dir /home/appuser appuser && \
    mkdir -p /home/appuser/.poindexter/generated-images && \
    chown -R appuser:appgroup /app /home/appuser
USER appuser

EXPOSE 9836

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD wget -qO /dev/null http://localhost:9836/health || exit 1

CMD ["python", "server.py", "--host", "0.0.0.0", "--port", "9836"]

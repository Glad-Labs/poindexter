# Rendered Alertmanager config (#524) — RenderAlertmanagerConfigJob writes
# this from alertmanager.yml.tmpl with a real telegram_chat_id substituted
# in. It must NEVER be committed (public-mirror chat_id leak). The template
# (.tmpl) is the only tracked source. In prod the render target is a Docker
# volume, but guard the repo path too in case someone renders locally.
infrastructure/prometheus/alertmanager.yml

# ============================================================
# IDE & OS
# ============================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
nul

# ============================================================
# Node.js
# ============================================================
# NO trailing slash — that form matches directories ONLY, and agent
# worktrees under .claude/worktrees/ carry `node_modules` as a SYMLINK to
# the main checkout so they can share deps. A symlink is not a directory,
# so `node_modules/` did not match it and `git add -A` swept it into a
# commit (#2913, 2026-07-31). Its content was the absolute path
# `/home/mattm/<checkout>/node_modules`, so checking it out AT that path
# produced a symlink pointing at itself — which replaced the real
# directory and wiped every installed dep in the main checkout.
node_modules
.next/
build/
dist/
.pnp.*
npm-debug.log*
yarn-error.log*

